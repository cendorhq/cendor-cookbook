# Private working material — NEVER committed (this repo is public).
plan/

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# Environments & tooling caches
.venv/
.uv/
.ruff_cache/
.pytest_cache/
.mypy_cache/
.coverage
coverage.json
htmlcov/
node_modules/
# npm lockfiles: like uv.lock below, not committed — the JS recipes pin @cendor/* ranges so
# `npm install` re-resolves the current shipped minor each CI run (drift shows up as a red job).
package-lock.json

# uv lockfile — intentionally not committed so CI re-resolves the current shipped
# packages each run (the weekly cron catches dependency drift). Recipes pin ranges,
# not a frozen lock.
uv.lock

# Secrets & local config — recipes run offline with NO key; never commit one.
.env
*.env

# Editor / OS
.idea/
.vscode/
.DS_Store
*.log

# Cassettes recorded locally by the quickstart/provider RECORD paths land here and
# are generated artifacts, not fixtures. (Committed test fixtures live under a
# recipe's own fixtures/ dir and are added explicitly.)
**/_recordings/

# Audit chains written by the agent recipes' `serve.py` / `serve.mjs` when a reader drives them
# from the M365 Agents Playground. They are per-run evidence, not fixtures — and without this rule
# following the recipe's own runbook dirties the tree.
chain.jsonl
**/chain-*.jsonl
